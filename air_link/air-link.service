[Unit]
Description=Air Link

[Service]
Type=simple
WorkingDirectory=/home/USER/
ExecCondition=/usr/bin/env bash --login -c 'command -v air-link >/dev/null || { echo "Error: air-link command not found. Please run \'uv tool install air-link\' as user \'USER\'." >&2; exit 1; }'
ExecStart=/usr/bin/env bash --login -c "air-link run"
User=USER
Group=USER
# allow raw ICMP sockets for the network history without running as root
AmbientCapabilities=CAP_NET_RAW
Restart=always

[Install]
WantedBy=multi-user.target
